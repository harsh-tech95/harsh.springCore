<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    
    <bean name="Add" class="com.my.spring.model.Address">
    
    <property name="state" value="up"></property>
    <property name="city" value="Bareilly"></property>
    </bean>
    
    
    <bean name="emp2" class="com.my.spring.model.employee">
    
    <property name="id" value="101"></property>
    <property name="name" value="Harsh Mishra"></property>
    <property name="gender" value="male"></property>
    <property name="list">
    
    <list>
    <value>200</value>
    <value>200</value>
    <value>200</value>
    <value>200</value>
    
    </list>
    
    </property>
    
    <property name="set">
    
    <set>
    
    <value>200</value>
    <value>201</value>
    <value>202</value>
    <value>203</value>
    <value>204</value>
    <value>204</value>

    
    </set>
    
    </property>
    
    
    <property name="map">
    
    <map>
    
    <entry key="1" value="HARSH"></entry>
    <entry key="2" value="Arpit"></entry>
    <entry key="3" value="Prem"></entry>
    
    
    </map>
    
    </property>
    
    </bean>

</beans>